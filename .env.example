# Copy to .env.local for local development. .env* files are gitignored.
#
# Only VITE_-prefixed variables reach the browser bundle. That is deliberate:
# it is what stops a server-side secret being shipped to the client by accident.

# Supabase project URL — Project settings > Data API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# The anon/publishable key — Project settings > API keys.
# This key is PUBLIC by design; it ships in the JS bundle and anyone can read
# it. It is safe only because Row Level Security decides what it can reach, so
# no table may ever be left without RLS enabled.
VITE_SUPABASE_ANON_KEY=your-anon-key

# NEVER put the service_role key here or in any VITE_ variable. It bypasses RLS
# entirely. It belongs only in Supabase Edge Function secrets.
